FROM php:8.3-fpm-alpine

RUN apk add --no-cache nginx supervisor postgresql-dev dcron \
    && docker-php-ext-install pdo pdo_pgsql

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

RUN mkdir -p /var/lib/php/sessions \
    && printf "session.save_path=/var/lib/php/sessions\n" > /usr/local/etc/php/conf.d/sessions.ini

COPY docker/nginx.k8s.conf /etc/nginx/http.d/default.conf
COPY docker/supervisor.conf /etc/supervisor.conf
COPY docker/entrypoint.k8s.sh /usr/local/bin/docker-entrypoint

RUN chmod +x /usr/local/bin/docker-entrypoint \
    && sed -i 's/\r$//' /usr/local/bin/docker-entrypoint

WORKDIR /var/www/app
COPY . .

RUN composer install --no-dev --optimize-autoloader

ENTRYPOINT ["sh", "/usr/local/bin/docker-entrypoint"]
