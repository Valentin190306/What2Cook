# Database configuration (Development settings - adjust as needed for production)
DB_HOST=database
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Spoonacular API key (Change the documentation to reflect the new key in use)
SPOONACULAR_KEY=
#SPOONACULAR_KEY=
#SPOONACULAR_KEY=

# API keys for OpenAI and Gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# LibreTranslate self-hosted URL (used when provider is 'libretranslate')
LIBRETRANSLATE_URL=http://libretranslate:5000

# Translation settings - set to false to disable translation features
ENABLE_INPUT_TRANSLATION=true
ENABLE_OUTPUT_TRANSLATION=true

# Translation provider - options: 'openai', 'gemini', 'libretranslate'
TRANSLATION_PROVIDER=libretranslate

# Background job API key (separada de la de producción para no agotar la cuota)
SPOONACULAR_KEY_BACKGROUND=

# ── Recipe Preload Job ───────────────────────────────────────────────────────
# Habilita la consulta a recipe_translations antes de llamar a Spoonacular
RECIPES_TABLE_ENABLED=true
# Límite diario de puntos Spoonacular para el job de precarga
TRANSLATION_DAILY_LIMIT=150
# Cuántos términos de búsqueda usar por ejecución
TRANSLATION_SEARCH_TERMS=5